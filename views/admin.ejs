<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin — Fuco AI</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="topbar">
    <a href="/" class="topbar-logo">
      <svg width="32" height="32" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="36" height="36" rx="10" fill="#2563eb"/>
        <circle cx="18" cy="14" r="5" fill="#fff"/>
        <circle cx="10" cy="24" r="3.5" fill="#fff" opacity="0.7"/>
        <circle cx="18" cy="27" r="3.5" fill="#fff" opacity="0.85"/>
        <circle cx="26" cy="24" r="3.5" fill="#fff" opacity="0.7"/>
        <line x1="18" y1="19" x2="10" y2="24" stroke="#fff" stroke-width="1.2" opacity="0.5"/>
        <line x1="18" y1="19" x2="18" y2="27" stroke="#fff" stroke-width="1.2" opacity="0.5"/>
        <line x1="18" y1="19" x2="26" y2="24" stroke="#fff" stroke-width="1.2" opacity="0.5"/>
      </svg>
      Fuco AI
    </a>
    <div class="topbar-right">
      <span class="topbar-username"><%= user.username %></span>
      <a href="/admin/council" class="btn btn-ghost btn-sm">🧠 Hội đồng AI</a>
      <a href="/" class="btn btn-ghost btn-sm">Trang chủ</a>
      <a href="/logout" class="btn btn-ghost btn-sm">Đăng xuất</a>
    </div>
  </div>

  <div class="container">
    <div class="page-header">
      <div class="page-title">Quản trị</div>
    </div>

    <div class="tab-list">
      <button class="tab-btn active" onclick="switchTab('users', this)">Tài khoản</button>
      <button class="tab-btn" onclick="switchTab('agents', this)">AI Nhân viên</button>
      <button class="tab-btn" onclick="switchTab('teams', this)">Teams</button>
    </div>

    <!-- TAB TÀI KHOẢN -->
    <div class="tab-panel active" id="tab-users">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Username</th>
              <th>Email</th>
              <th>Vai trò</th>
              <th>Trạng thái</th>
              <th>Tạo team</th>
              <th>Giới hạn team</th>
              <th>Hành động</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(u => { %>
              <tr id="user-<%= u._id %>">
                <td><strong><%= u.username %></strong></td>
                <td style="color:var(--text2)"><%= u.email %></td>
                <td><span class="badge <%= u.role === 'admin' ? 'badge-admin' : 'badge-user' %>"><%= u.role %></span></td>
                <td><span class="badge <%= u.locked ? 'badge-locked' : 'badge-active' %>" id="lock-badge-<%= u._id %>"><%= u.locked ? 'Bị khóa' : 'Hoạt động' %></span></td>
                <td>
                  <% if (u.role !== 'admin') { %>
                    <button class="btn btn-ghost btn-sm" id="team-btn-<%= u._id %>" onclick="toggleTeam('<%= u._id %>')">
                      <%= u.canCreateTeam ? '✅ Có' : '❌ Không' %>
                    </button>
                  <% } else { %>
                    <span style="color:var(--text3);font-size:13px">Không giới hạn</span>
                  <% } %>
                </td>
                <td>
                  <% if (u.role !== 'admin') { %>
                    <div style="display:flex;gap:6px;align-items:center">
                      <input type="number" class="limit-input" id="limit-<%= u._id %>" value="<%= u.teamLimit || 0 %>" min="0">
                      <button class="btn btn-ghost btn-sm" onclick="setLimit('<%= u._id %>')">Lưu</button>
                    </div>
                  <% } else { %>
                    <span style="color:var(--text3);font-size:13px">—</span>
                  <% } %>
                </td>
                <td>
                  <% if (u.role !== 'admin') { %>
                    <button class="btn btn-sm <%= u.locked ? 'btn-primary' : 'btn-danger' %>" id="lock-btn-<%= u._id %>" onclick="toggleLock('<%= u._id %>')">
                      <%= u.locked ? 'Mở khóa' : 'Khóa' %>
                    </button>
                  <% } else { %>
                    <span style="color:var(--text3);font-size:13px">—</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- TAB AI NHÂN VIÊN -->
    <div class="tab-panel" id="tab-agents">
      <div class="add-agent-form">
        <div class="add-agent-title">Thêm AI nhân viên mới</div>
        <div class="form-row">
          <select id="agentPlatform">
            <option value="" disabled selected>-- Chọn nền tảng --</option>
            <option value="Groq">Groq</option>
            <option value="Gemini">Gemini</option>
            <option value="OpenRouter">OpenRouter</option>
            <option value="Together AI">Together AI</option>
            <option value="Cohere">Cohere</option>
            <option value="Mistral">Mistral</option>
            <option value="Cerebras">Cerebras</option>
          </select>
          <input type="text" id="agentModel" placeholder="Tên model (vd: llama-3.3-70b-versatile)">
          <input type="text" id="agentApiKey" placeholder="API Key">
          <select id="agentGroup">
            <option value="Lập trình & Kỹ thuật">Lập trình & Kỹ thuật</option>
            <option value="Viết lách & Nội dung">Viết lách & Nội dung</option>
            <option value="Phân tích & Nghiên cứu">Phân tích & Nghiên cứu</option>
            <option value="Sáng tạo & Thiết kế">Sáng tạo & Thiết kế</option>
            <option value="Trợ lý & Quản lý">Trợ lý & Quản lý</option>
          </select>
        </div>
        <div class="form-row">
          <textarea id="agentDesc" placeholder="Mô tả AI này giỏi làm gì..." rows="2" style="grid-column:1/-1"></textarea>
        </div>
        <button class="btn btn-primary" onclick="addAgent()" id="addAgentBtn">+ Thêm AI</button>
        <span id="addAgentMsg" style="margin-left:12px;font-size:13px;color:var(--text2)"></span>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Tên</th>
              <th>Nền tảng</th>
              <th>Nhóm</th>
              <th>Mô tả</th>
              <th>Trạng thái</th>
              <th>Hành động</th>
            </tr>
          </thead>
          <tbody id="agentsTable">
            <% agents.filter(a => a.role === 'employee').forEach(a => { %>
              <tr id="agent-<%= a._id %>">
                <td><strong><%= a.name %></strong></td>
                <td><%= a.platform %></td>
                <td><%= a.group %></td>
                <td style="color:var(--text2);max-width:200px"><%= a.description %></td>
                <td><span class="badge badge-active">Hoạt động</span></td>
                <td>
                  <button class="btn btn-danger btn-sm" onclick="deleteAgent('<%= a._id %>')">Xóa</button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- TAB TEAMS -->
    <div class="tab-panel" id="tab-teams">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Tên team</th>
              <th>Chủ sở hữu</th>
              <th>Số AI</th>
              <th>Ngày tạo</th>
              <th>Hành động</th>
            </tr>
          </thead>
          <tbody>
            <% teams.forEach(t => { %>
              <tr id="team-<%= t._id %>">
                <td><strong><%= t.name %></strong></td>
                <td style="color:var(--text2)"><%= t.owner %></td>
                <td><%= t.members.length %> AI</td>
                <td style="color:var(--text2)"><%= new Date(t.createdAt).toLocaleDateString('vi-VN') %></td>
                <td>
                  <button class="btn btn-danger btn-sm" onclick="deleteTeam('<%= t._id %>')">Xóa</button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    function switchTab(name, btn) {
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById('tab-' + name).classList.add('active');
      btn.classList.add('active');
    }

    async function toggleLock(id) {
      const res = await fetch(`/admin/users/${id}/toggle-lock`, { method: 'POST' });
      const data = await res.json();
      if (data.ok) {
        document.getElementById(`lock-badge-${id}`).textContent = data.locked ? 'Bị khóa' : 'Hoạt động';
        document.getElementById(`lock-badge-${id}`).className = `badge ${data.locked ? 'badge-locked' : 'badge-active'}`;
        const btn = document.getElementById(`lock-btn-${id}`);
        btn.textContent = data.locked ? 'Mở khóa' : 'Khóa';
        btn.className = `btn btn-sm ${data.locked ? 'btn-primary' : 'btn-danger'}`;
      }
    }

    async function toggleTeam(id) {
      const res = await fetch(`/admin/users/${id}/toggle-team`, { method: 'POST' });
      const data = await res.json();
      if (data.ok) {
        document.getElementById(`team-btn-${id}`).textContent = data.canCreateTeam ? '✅ Có' : '❌ Không';
      }
    }

    async function setLimit(id) {
      const limit = document.getElementById(`limit-${id}`).value;
      const res = await fetch(`/admin/users/${id}/set-team-limit`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ limit })
      });
      const data = await res.json();
      if (data.ok) alert('Đã lưu giới hạn team.');
    }

    async function addAgent() {
      const platform = document.getElementById('agentPlatform').value;
      const model = document.getElementById('agentModel').value.trim();
      const apiKey = document.getElementById('agentApiKey').value.trim();
      const group = document.getElementById('agentGroup').value;
      const description = document.getElementById('agentDesc').value.trim();

      if (!model || !apiKey || !description) { showAgentMsg('Vui lòng điền đầy đủ thông tin.'); return; }

      const btn = document.getElementById('addAgentBtn');
      btn.disabled = true;
      btn.textContent = 'Đang thêm...';
      showAgentMsg('Đang đặt tên cho AI...');

      const res = await fetch('/admin/agents', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ platform, model, apiKey, group, description })
      });
      const data = await res.json();

      if (data.ok) {
        showAgentMsg(`✅ Đã thêm AI: ${data.name}`);
        document.getElementById('agentModel').value = '';
        document.getElementById('agentApiKey').value = '';
        document.getElementById('agentDesc').value = '';
        setTimeout(() => location.reload(), 1500);
      } else {
        showAgentMsg('Có lỗi xảy ra, vui lòng thử lại.');
      }
      btn.disabled = false;
      btn.textContent = '+ Thêm AI';
    }

    function showAgentMsg(msg) {
      document.getElementById('addAgentMsg').textContent = msg;
    }

    async function deleteAgent(id) {
      if (!confirm('Xóa AI này?')) return;
      const res = await fetch(`/admin/agents/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (data.ok) document.getElementById(`agent-${id}`).remove();
    }

    async function deleteTeam(id) {
      if (!confirm('Xóa team này?')) return;
      const res = await fetch(`/admin/teams/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (data.ok) document.getElementById(`team-${id}`).remove();
    }
  </script>
</body>
</html>
