<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quên mật khẩu — Fuco AI</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="auth-page">
    <div class="auth-box">
      <div class="auth-logo">
        <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="36" height="36" rx="10" fill="#2563eb"/>
          <circle cx="18" cy="14" r="5" fill="#fff"/>
          <circle cx="10" cy="24" r="3.5" fill="#fff" opacity="0.7"/>
          <circle cx="18" cy="27" r="3.5" fill="#fff" opacity="0.85"/>
          <circle cx="26" cy="24" r="3.5" fill="#fff" opacity="0.7"/>
          <line x1="18" y1="19" x2="10" y2="24" stroke="#fff" stroke-width="1.2" opacity="0.5"/>
          <line x1="18" y1="19" x2="18" y2="27" stroke="#fff" stroke-width="1.2" opacity="0.5"/>
          <line x1="18" y1="19" x2="26" y2="24" stroke="#fff" stroke-width="1.2" opacity="0.5"/>
        </svg>
        <span>Fuco AI</span>
      </div>
      <div class="auth-title">Quên mật khẩu</div>
      <% if (error) { %>
        <div class="error-msg"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="success-msg"><%= success %></div>
        <div class="auth-link" style="margin-top:0">
          <a href="/reset-password">Nhập mã đặt lại mật khẩu</a>
        </div>
      <% } else { %>
        <form method="POST" action="/forgot-password">
          <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" placeholder="Nhập email đã đăng ký" required autofocus>
          </div>
          <button type="submit" class="auth-submit">Gửi mã đặt lại</button>
        </form>
        <div class="auth-link">
          <a href="/login">Quay lại đăng nhập</a>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>
